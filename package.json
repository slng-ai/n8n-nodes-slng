{
    "name": "n8n-nodes-slng",
    "version": "0.4.0",
    "description": "n8n community node for SLNG: text-to-speech, speech-to-text, and a trigger that registers a webhook tool on a SLNG voice agent",
    "license": "MIT",
    "homepage": "",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Nicolas Grenié",
        "email": "nicolas.grenie@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/slng-ai/n8n-nodes-slng.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "prepack": "npm run build",
        "release": "semantic-release"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/",
        "provenance": true
    },
    "files": [
        "dist",
        "!dist/tsconfig.tsbuildinfo"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/SlngApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Slng/Slng.node.js",
            "dist/nodes/SlngTrigger/SlngTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^12.0.8",
        "@semantic-release/npm": "^13.1.5",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "eslint": "9.29.0",
        "prettier": "3.6.2",
        "semantic-release": "^25.0.5",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
