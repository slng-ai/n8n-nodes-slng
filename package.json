{
    "name": "n8n-nodes-slng",
    "version": "0.1.0",
    "description": "n8n community node for slng.ai: text-to-speech, speech-to-text, and a trigger that registers a webhook tool on a slng voice agent",
    "license": "MIT",
    "homepage": "",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Nicolas Grenié",
        "email": "nicolas.grenie@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/slng-ai/n8n-nodes-slng.git"
    },
   "scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/SlngApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Slng/Slng.node.js",
            "dist/nodes/SlngTrigger/SlngTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.29.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
